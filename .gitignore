# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log

# eval harness self-checks (not evidence)
evals/patch/results/FAKE-*.json

# 70 MB HDR environment map from the 3D prototype; unreferenced, keep it out of git history
public/textures/env.exr

# benchmark outputs (only the recorded before/after evidence is committed)
bench/results/*
!bench/results/live-before.json
!bench/results/live-after.json

# Songs are copyrighted recordings. By the owner's decision the two demo tracks are committed
# (so the demo works after checkout); any other track stays local. The analysis/cue files
# derived from them (beat times, our lighting program) are committed too.
public/audio/*.mp3
public/audio/*.wav
public/audio/*.m4a
public/audio/*.ogg
public/audio/*.flac
!public/audio/A Sky Full of Stars.mp3
!public/audio/Yellow.mp3
!bench/results/stage-*.json

# Old /test-3d 3D prototype (replaced by the homepage show, docs/homepage-show.md). Kept on disk
# for reference, never committed: ~12 MB of models and the code that used them.
/app/test-3d/
/components/canvas/
/public/models/
/public/moving-head/
/public/low_moving_head.glb
/public/scene-transformed.glb
/public/strobe.glb
/public/truss.glb
/public/tunnel-transformed.glb
