# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log

# eval harness self-checks (not evidence)
evals/patch/results/FAKE-*.json

# 70 MB HDR environment map from the 3D prototype; unreferenced, keep it out of git history
public/textures/env.exr

# benchmark outputs (only the recorded before/after evidence is committed)
bench/results/*
!bench/results/live-before.json
!bench/results/live-after.json

# Songs are copyrighted recordings: use them locally, never commit or deploy them.
# The analysis/cue files derived from them (beat times, our lighting program) are fine to commit.
public/audio/*.mp3
public/audio/*.wav
public/audio/*.m4a
public/audio/*.ogg
public/audio/*.flac
