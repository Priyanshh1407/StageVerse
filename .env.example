# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB connection string (Atlas or local). Transactions need a replica set.
MONGODB_URI=mongodb://localhost:27017/stageverse?replicaSet=rs0

# Long random string used to sign session JWTs (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Google Gemini API key (AI description / patch features)
GEMINI_API_KEY=

# Cloudinary (media uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated origins allowed to open a Socket.IO connection (defaults to same origin)
SOCKET_ALLOWED_ORIGINS=http://localhost:3000
