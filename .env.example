# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB connection string (Atlas or a local mongod)
MONGODB_URI=mongodb://localhost:27017/stageverse

# Long random string used to sign session JWTs (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Google Gemini API key (AI copy, event descriptions, DMX patch assistant)
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash) and the fallback used when it's
# overloaded or times out (default gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Cloudinary (media uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated origins allowed to open a Socket.IO connection (defaults to same origin)
SOCKET_ALLOWED_ORIGINS=http://localhost:3000
