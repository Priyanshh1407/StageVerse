# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB connection string (Atlas or a local mongod)
MONGODB_URI=mongodb://localhost:27017/stageverse

# Long random string used to sign session JWTs (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# AI providers, tried in order until one answers (the app degrades to non-AI fallbacks if all fail):
#   1. GEMINI_MODEL           default gemini-3.8-flash
#   2. GEMINI_FALLBACK_MODEL  default gemini-3.5-flash-lite
#   3. GROQ_MODEL             default openai/gpt-oss-120b   (only used when GROQ_API_KEY is set)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Free key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Cloudinary (media uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated origins allowed to open a Socket.IO connection (defaults to same origin)
SOCKET_ALLOWED_ORIGINS=http://localhost:3000
